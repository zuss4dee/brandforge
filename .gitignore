# Environment
.env
.env.*
!.env.example

# Data artifacts — never commit corpora snapshots, zone dumps, or built filters.
# Exception: data/corpus/artifacts/.gitkeep is tracked so check_corpus can tell
# "misconfigured path" from "nothing built yet" (services/corpus/config.py).
# Git cannot re-include a file whose parent is excluded, hence the ladder.
data/*
!data/corpus/
data/corpus/*
!data/corpus/artifacts/
data/corpus/artifacts/*
!data/corpus/artifacts/.gitkeep
*.zone
*.zone.gz
*.bloom
corpora/generated/

# Local tool state
.claude/settings.local.json

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
